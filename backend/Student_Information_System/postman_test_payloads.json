  "8_grades_and_components": {
    "input_student_grade": {
      "method": "PUT",
      "url": "http://localhost:8080/api/enrollments/1/grade",
      "headers": {
        "Authorization": "Bearer <LECTURER_OR_ADMIN_TOKEN>"
      },
      "description": "Nhập điểm cho 1 sinh viên (enrollment id = 1)",
      "body": {
        "componentScore": 8.5,
        "finalScore": 9.0,
        "componentScores": {
          "1": 8.5,
          "2": 9.0
        }
      }
    },
    "config_grade_components": {
      "method": "PUT",
      "url": "http://localhost:8080/api/course-sections/1/grade-components",
      "headers": {
        "Authorization": "Bearer <ADMIN_TOKEN>"
      },
      "description": "Cấu hình tỉ lệ phần trăm các cột điểm (tổng weight phải bằng 100)",
      "body": {
        "components": [
          {
            "componentName": "Chuyên cần",
            "weight": 10.0,
            "maxScore": 10.0,
            "componentType": "ATTENDANCE",
            "displayOrder": 1,
            "required": true
          },
          {
            "componentName": "Kiểm tra giữa kỳ",
            "weight": 30.0,
            "maxScore": 10.0,
            "componentType": "MIDTERM",
            "displayOrder": 2,
            "required": true
          },
          {
            "componentName": "Thi cuối kỳ",
            "weight": 60.0,
            "maxScore": 10.0,
            "componentType": "FINAL",
            "displayOrder": 3,
            "required": true
          }
        ]
      }
    }
  },

  "9_notifications": {
    "get_my_notifications": {
      "method": "GET",
      "url": "http://localhost:8080/api/notifications",
      "headers": {
        "Authorization": "Bearer <TOKEN>"
      },
      "description": "Lấy danh sách thông báo của người dùng hiện tại (kèm thông báo chung)"
    },
    "get_unread_count": {
      "method": "GET",
      "url": "http://localhost:8080/api/notifications/unread-count",
      "headers": {
        "Authorization": "Bearer <TOKEN>"
      },
      "description": "Lấy số lượng thông báo chưa đọc"
    },
    "mark_as_read": {
      "method": "PUT",
      "url": "http://localhost:8080/api/notifications/1/read",
      "headers": {
        "Authorization": "Bearer <TOKEN>"
      },
      "description": "Đánh dấu 1 thông báo là đã đọc"
    },
    "mark_all_as_read": {
      "method": "PUT",
      "url": "http://localhost:8080/api/notifications/read-all",
      "headers": {
        "Authorization": "Bearer <TOKEN>"
      },
      "description": "Đánh dấu tất cả thông báo là đã đọc"
    },
    "admin_create_broadcast_notification": {
      "method": "POST",
      "url": "http://localhost:8080/api/notifications",
      "headers": {
        "Authorization": "Bearer <ADMIN_TOKEN>"
      },
      "description": "Admin tạo thông báo gửi cho toàn bộ Sinh viên (targetRole = STUDENT)",
      "body": {
        "title": "Thông báo lịch nghỉ lễ và kế hoạch học bù",
        "content": "Toàn thể sinh viên chú ý: Nhà trường thông báo lịch nghỉ lễ từ ngày mai. Kế hoạch học bù sẽ được giảng viên thông báo trên lớp học phần.",
        "type": "ANNOUNCEMENT",
        "targetRole": "STUDENT"
      }
    },
    "admin_create_personal_notification": {
      "method": "POST",
      "url": "http://localhost:8080/api/notifications",
      "headers": {
        "Authorization": "Bearer <ADMIN_TOKEN>"
      },
      "description": "Admin gửi thông báo riêng cho 1 người dùng (recipientId = userId)",
      "body": {
        "title": "Nhắc nhở nộp học phí và hoàn tất hồ sơ",
        "content": "Bạn còn thiếu chứng chỉ tin học văn phòng trong hồ sơ sinh viên, vui lòng nộp bổ sung tại phòng đào tạo trước ngày 15/11.",
        "type": "ACADEMIC",
        "recipientId": 8
      }
    },
    "delete_notification": {
      "method": "DELETE",
      "url": "http://localhost:8080/api/notifications/1",
      "headers": {
        "Authorization": "Bearer <ADMIN_TOKEN>"
      },
      "description": "Xóa thông báo theo ID"
    }
  }
}

