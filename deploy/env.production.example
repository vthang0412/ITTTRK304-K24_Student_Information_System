# ============================================================
# SIS - Production environment template
#
# Copy this file to /opt/sis/.env on the VPS, replace every
# placeholder, then protect it:
#   chmod 600 /opt/sis/.env
#
# NEVER commit the real .env file and NEVER store it in GitHub.
# ============================================================

# ---------- Database ----------
DB_NAME=sis_db
DB_USERNAME=sis_user
DB_PASSWORD=replace-with-a-strong-db-password
DB_ROOT_PASSWORD=replace-with-a-strong-root-password

# ---------- Backend ----------
# Must be at least 32 characters. Use a random value.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Production always runs the prod profile.
SPRING_PROFILES_ACTIVE=prod

# Demo accounts/data must never be seeded in production.
SPRING_SQL_INIT_MODE=never

# Flyway creates the schema on a fresh database and baselines an existing one.
# Set to false only after the schema has been provisioned manually.
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true

# Keep API docs disabled in production unless you really need them.
SWAGGER_ENABLED=false

# Comma-separated origins allowed to call the API directly, e.g.
# https://sis.example.com . Leave empty when the SPA is served same-origin.
APP_CORS_ALLOWED_ORIGINS=

# ---------- Automatic rollback ----------
# 1 (default): roll back to the previous image when the new one is unhealthy.
# 0: keep the failed deployment for manual inspection.
AUTO_ROLLBACK=1

# ---------- GHCR images ----------
# Lowercase GitHub owner + repository name, suffixed with -backend/-frontend.
# The deploy workflow passes these values, but keeping them here lets
# ./rollback.sh work without the workflow.
BACKEND_IMAGE=ghcr.io/vthang0412/itttrk304-k24_student_information_system-backend
FRONTEND_IMAGE=ghcr.io/vthang0412/itttrk304-k24_student_information_system-frontend

# ---------- Frontend publishing ----------
# Bind to loopback only; host Nginx terminates HTTPS and proxies here.
# Use 0.0.0.0 only temporarily if no reverse proxy is configured.
FRONTEND_BIND_IP=127.0.0.1
FRONTEND_HOST_PORT=8080
