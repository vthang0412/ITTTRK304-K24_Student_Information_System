# ============================================================
# SIS - Docker Compose environment template
# Copy this file to .env and replace every placeholder value.
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (Linux/macOS)
# Never commit the real .env file.
# ============================================================

# ---------- MySQL / Database ----------
# Database host as seen from the backend container.
# Keep "mysql" (the Compose service name); do NOT use localhost here.
DB_HOST=mysql

# Database port inside the Docker network.
DB_PORT=3306

# Database name created by the MySQL container (backend uses the same value).
DB_NAME=sis_db

# Application database user created by the MySQL container.
DB_USERNAME=sis_user

# Password for the application database user. Use a strong, unique value.
DB_PASSWORD=replace-with-a-strong-db-password

# Password for the MySQL root user. Use a strong, unique value.
DB_ROOT_PASSWORD=replace-with-a-strong-root-password

# Host port mapped to MySQL port 3306 inside the container.
# Use 3307 to avoid clashing with a local MySQL installation on 3306.
MYSQL_HOST_PORT=3307

# ---------- Backend ----------
# The local compose stack runs the development profile (demo data + Swagger).
SPRING_PROFILES_ACTIVE=dev

# Host port mapped to the Spring Boot port 8080 inside the container.
BACKEND_PORT=8080

# JWT signing secret. Must be at least 32 characters and kept secret.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# ---------- Frontend ----------
# Host port mapped to the Nginx port 80 inside the container.
FRONTEND_PORT=5173

# Base URL used by the browser to call the API at build time.
# "/" means same-origin requests, proxied by Nginx to the backend container.
VITE_API_BASE_URL=/
