# ============================================================
# SIS - Docker Compose environment template
# Copy this file to .env and replace every placeholder value.
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (Linux/macOS)
# Never commit the real .env file.
# ============================================================

# ---------- MySQL / Database ----------
# Database name created by the development MySQL container.
# The development backend always connects to its local Compose service "mysql".
DB_NAME=sis_db

# Application database user created by the MySQL container.
DB_USERNAME=sis_user

# Password for the application database user. Use a strong, unique value.
DB_PASSWORD=replace-with-a-strong-db-password

# Password for the MySQL root user. Use a strong, unique value.
DB_ROOT_PASSWORD=replace-with-a-strong-root-password

# Host port mapped to MySQL port 3306 inside the container.
# Use 3307 to avoid clashing with a local MySQL installation on 3306.
# It is bound to 127.0.0.1 only, so the dev database is not exposed to the LAN.
MYSQL_HOST_PORT=3307

# ---------- Backend ----------
# The local Compose stack selects the dev profile and seed mode explicitly.

# Host port mapped to the Spring Boot port 8080 inside the container.
BACKEND_PORT=8080

# Replace with a random secret of at least 32 UTF-8 bytes.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRATION_MS=86400000

# ---------- Optional integrations / limits ----------
SWAGGER_ENABLED=true
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
OTP_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5
ENROLLMENT_MAX_CREDITS_PER_SEMESTER=24
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_RATE_LIMIT_PER_HOUR=60

# ---------- Frontend ----------
# Host port mapped to the Nginx port 8080 inside the container
# (nginx-unprivileged cannot bind to port 80).
FRONTEND_PORT=5173

# Base URL used by the browser to call the API at build time.
# "/" means same-origin requests, proxied by Nginx to the backend container.
VITE_API_BASE_URL=/
